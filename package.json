{
  "name": "wedding-invitations",
  "version": "1.0.0",
  "description": "Wedding invitation website system with multiple themes, preview generation, and RSVP management",
  "main": "scripts/generate-preview.js",
  "scripts": {
    "serve": "node scripts/serve.js",
    "preview": "node scripts/generate-preview.js",
    "layout": "node scripts/generate-layout-preview.js",
    "layout:all": "node scripts/generate-layout-preview.js --all",
    "layout:list": "node scripts/generate-layout-preview.js --list",
    "generate": "node scripts/generate-final.js",
    "cleanup": "node scripts/cleanup-expired.js",
    "validate": "node -e \"const c = require('./scripts/config'); console.log(c.validateConfig())\"",
    "images": "node scripts/generate-images.js",
    "images:list": "node scripts/generate-images.js --list",
    "images:dry-run": "node scripts/generate-images.js --dry-run",
    "images:chatgpt": "node scripts/generate-images-chatgpt.js",
    "images:chatgpt:list": "node scripts/generate-images-chatgpt.js --list",
    "campaign:10day": "node scripts/generate-instagram-10day-assets.js",
    "chrome:debug": "open -a 'Google Chrome' --args --remote-debugging-port=9222",
    "screenshots": "node scripts/generate-screenshots.js"
  },
  "keywords": [
    "wedding",
    "invitation",
    "rsvp",
    "static-site"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fs-extra": "^11.2.0",
    "playwright": "^1.58.1"
  }
}
